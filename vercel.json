{
  "services": [
    {
      "name": "frontend",
      "rootDirectory": ".",
      "framework": "vite"
    },
    {
      "name": "backend",
      "rootDirectory": "backend",
      "framework": "express"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
